# Copy to .env (git-ignored) to override defaults. Every value is optional.

# HTTP bind address and port for the SentryFlow MCP server. Keep 127.0.0.1 unless you
# deliberately expose it (e.g. through a tunnel) — see docs/THREAT_MODEL.md.
SENTRYFLOW_HOST=127.0.0.1
SENTRYFLOW_PORT=8787

# Comma-separated list of allowed browser Origins for /mcp (DNS-rebinding protection).
SENTRYFLOW_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8787,http://127.0.0.1:8787

# Bearer tokens for the two MCP roles. If unset, random tokens are generated at startup and
# written to data/dev-credentials.json (git-ignored). Use long random values if you set them.
SENTRYFLOW_AGENT_TOKEN=
SENTRYFLOW_APPROVER_TOKEN=

# Serve dev credentials to the local web UI at /api/dev/credentials (loopback requests only).
# Set to "false" if you configure tokens out of band.
SENTRYFLOW_EXPOSE_DEV_CREDENTIALS=true

# Where state.json and audit.jsonl live.
SENTRYFLOW_DATA_DIR=./data

# Policy file (defaults to the bundled server/policy/default-policy.json).
SENTRYFLOW_POLICY_FILE=

# How long an approval stays valid after it is granted.
SENTRYFLOW_APPROVAL_TTL_SECONDS=300

# Planner: "ollama" (falls back to rules on any failure) or "rules" (deterministic only).
SENTRYFLOW_PLANNER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=45000
